{
  "name": "@tscircuit/standalone",
  "version": "0.0.0-alpha.0",
  "private": true,
  "description": "Offline tscircuit platform and standalone binary preparation",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/tscircuit/tscircuit-standalone",
  "exports": "./lib/index.ts",
  "scripts": {
    "dev": "bun cli/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build-binary.ts",
    "smoke:binary": "bun scripts/smoke-binary.ts",
    "check": "bun run typecheck && bun test && bun run build && bun run smoke:binary"
  },
  "dependencies": {
    "@tscircuit/footprinter": "0.0.430"
  },
  "devDependencies": {
    "@tscircuit/props": "0.0.694",
    "@types/bun": "1.3.12",
    "circuit-json": "0.0.520",
    "typescript": "5.9.3"
  }
}
