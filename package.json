{
  "name": "@tscircuit/standalone",
  "version": "0.0.0-alpha.1",
  "private": true,
  "description": "Offline tscircuit platform and standalone binary preparation",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/tscircuit/tscircuit-standalone",
  "exports": "./lib/index.ts",
  "scripts": {
    "dev": "bun cli/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build-binary.ts",
    "smoke:binary": "bun scripts/smoke-binary.ts",
    "check": "bun run typecheck && bun test && bun run build && bun run smoke:binary"
  },
  "dependencies": {
    "@flatten-js/core": "1.6.12",
    "@tscircuit/core": "0.0.2116",
    "@tscircuit/eval": "0.0.1569",
    "@tscircuit/footprinter": "0.0.430",
    "@tscircuit/krt-wasm": "0.1.6",
    "@tscircuit/math-utils": "0.0.36",
    "@tscircuit/props": "0.0.697",
    "circuit-json": "0.0.525",
    "circuit-to-svg": "0.0.447",
    "kicad-to-circuit-json": "0.0.142",
    "kicadts": "0.0.58",
    "react": "19.2.7",
    "sucrase": "3.35.0",
    "tscircuit": "npm:@tscircuit/core@0.0.2116",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.12"
  }
}
