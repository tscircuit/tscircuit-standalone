{
  "name": "@tscircuit/standalone",
  "version": "0.0.3020",
  "private": true,
  "description": "Offline tscircuit platform and standalone binary preparation",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/tscircuit/tscircuit-standalone",
  "exports": "./lib/index.ts",
  "scripts": {
    "dev": "bun cli/main.ts",
    "build:catalog": "bun scripts/build-datasheets.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun run typecheck:ui",
    "build": "bun scripts/build-binary.ts",
    "smoke:binary": "bun scripts/smoke-binary.ts",
    "check": "bun run build:ui && bun run build && bun run typecheck && bun test && bun run smoke:binary",
    "build:ui": "bun scripts/build-ui.ts",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json"
  },
  "dependencies": {
    "@flatten-js/core": "1.6.15",
    "@rollup/wasm-node": "4.65.1",
    "@tscircuit/checks": "0.0.264",
    "@tscircuit/circuit-json-util": "0.0.129",
    "@tscircuit/cli": "0.1.2427",
    "@tscircuit/core": "0.0.2203",
    "@tscircuit/eval": "0.0.1660",
    "@tscircuit/footprinter": "0.0.444",
    "@tscircuit/krt-wasm": "0.1.9",
    "@tscircuit/math-utils": "0.0.38",
    "@tscircuit/props": "0.0.710",
    "circuit-json": "0.0.535",
    "circuit-to-svg": "0.0.453",
    "fflate": "0.8.3",
    "kicad-to-circuit-json": "0.0.145",
    "kicadts": "0.0.59",
    "react": "19.3.1",
    "sucrase": "3.35.1",
    "tscircuit": "0.0.3020",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "playwright": "1.64.1",
    "@types/node": "26.6.5"
  },
  "workspaces": [
    "ui"
  ],
  "trustedDependencies": [
    "altiumts"
  ]
}
