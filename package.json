{
  "name": "@tscircuit/standalone",
  "version": "0.0.2839",
  "private": true,
  "description": "Offline tscircuit platform and standalone binary preparation",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/tscircuit/tscircuit-standalone",
  "exports": "./lib/index.ts",
  "scripts": {
    "dev": "bun cli/main.ts",
    "build:catalog": "bun scripts/build-datasheets.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun run typecheck:ui",
    "build": "bun scripts/build-binary.ts",
    "smoke:binary": "bun scripts/smoke-binary.ts",
    "check": "bun run build:ui && bun run build && bun run typecheck && bun test && bun run smoke:binary",
    "build:ui": "bun scripts/build-ui.ts",
    "typecheck:ui": "tsc --noEmit -p ui/tsconfig.json"
  },
  "dependencies": {
    "@flatten-js/core": "1.6.12",
    "@rollup/wasm-node": "4.64.6",
    "@tscircuit/checks": "0.0.247",
    "@tscircuit/circuit-json-util": "0.0.121",
    "@tscircuit/cli": "github:tscircuit/cli#bdf4aa61798a92e30653cf3b1f59d3e3562a8ae9",
    "@tscircuit/core": "0.0.2132",
    "@tscircuit/eval": "0.0.1596",
    "@tscircuit/footprinter": "0.0.437",
    "@tscircuit/krt-wasm": "0.1.6",
    "@tscircuit/math-utils": "0.0.36",
    "@tscircuit/props": "0.0.700",
    "circuit-json": "0.0.525",
    "circuit-to-svg": "0.0.447",
    "fflate": "0.8.3",
    "kicad-to-circuit-json": "0.0.142",
    "kicadts": "0.0.58",
    "react": "19.2.7",
    "sucrase": "3.35.0",
    "tscircuit": "npm:@tscircuit/core@0.0.2132",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.12",
    "playwright": "1.61.1",
    "@types/node": "22.20.5"
  },
  "workspaces": [
    "ui"
  ],
  "overrides": {
    "altiumts": "0.0.59",
    "@tscircuit/core": "0.0.2132",
    "@tscircuit/eval": "0.0.1596",
    "@tscircuit/props": "0.0.700",
    "@tscircuit/checks": "0.0.247",
    "@tscircuit/circuit-json-util": "0.0.121"
  },
  "trustedDependencies": []
}
